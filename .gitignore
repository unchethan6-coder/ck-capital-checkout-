# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test & recon artifacts
qaqc-screenshots/
qaqc-mobile-screenshots/
test-results/
playwright-report/
RECON/
/*.mjs
graphify-out/
.audit-results/
.graphifyignore

# Payout cert downloads (seeded from Google Drive)
scripts/seed-data/certs/
scripts/seed-data/opt-certs/
scripts/seed-data/uploaded_media_cache.json
